Screen {
    background: #1e1e2e;
}

Horizontal {
    height: 1fr;
}

Vertical#left_panel {
    width: 1fr;
    height: 1fr;
}

DrinkingStatusPanel {
    height: 1fr;
    border: solid yellow;
    margin: 1;
    padding: 2;
}

RichLog#event_log {
    height: 10;
    border: solid green;
    margin: 0 1 1 1;
    padding: 0 1;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

BACChart {
    width: 1fr;
    height: 1fr;
    border: solid cyan;
    margin: 1;
}