/* Layout and presentation rules for the Textual BAC dashboard. */

/* Application-wide background and compact footer key labels. */
Screen {
    background: #1e1e2e;
}

FooterKey {
    .footer-key--key {
        padding: 0 0 0 1;
    }
}

/* Center the blackout modal above the dashboard. */
GameOverScreen {
    align: center middle;
    background: $background 80%;
}

#game_over_message {
    width: 44;
    height: auto;
    border: thick red;
    background: $surface;
    content-align: center middle;
    padding: 2 4;
}

/* Main two-column dashboard layout. */
Horizontal {
    height: 1fr;
}

Vertical#left_panel {
    width: 1fr;
    height: 1fr;
}

/* Left status area and scrollable event log. */
DrinkingStatusPanel {
    height: 1fr;
    border: solid yellow;
    margin: 1;
    padding: 1;
}

RichLog#event_log {
    height: 10;
    border: solid green;
    margin: 0 1;
    offset: 0 0;
    padding: 0 1;
    overflow-x: hidden;
    scrollbar-size: 1 1;
}

/* Right-side BAC chart. */
BACChart {
    width: 1fr;
    height: 1fr;
    border: solid cyan;
    margin: 1;
}
